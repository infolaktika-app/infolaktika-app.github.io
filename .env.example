# --- Browser (public) ---------------------------------------------------
# Supabase → Project Settings → API. Leave both empty to run in DEMO MODE
# (everything stored in this browser only, demo admin login enabled).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Students sign in with a username; it is mapped to <username>@<domain> for Supabase Auth.
VITE_LOGIN_EMAIL_DOMAIN=infolaktika.app

# --- Server only (used by scripts/create-admin.mjs, never bundled) -------
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Әкімші
